# Gmail IMAP & SMTP Credentials
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# OpenAI API Key for summarization, categorization, and drafting
OPENAI_API_KEY=sk-your_openai_api_key

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
WEBHOOK_SECRET_TOKEN=custom_alphanumeric_secret_token_123

# Autonomy & Folder Configuration
AUTO_ARCHIVE_FOLDER=MailPilot/Archived

# APScheduler Configuration
DIGEST_HOUR=8
TRIAGE_INTERVAL_MINUTES=60

# Gmail Fetch Limits (Truncate oldest first)
MAX_FETCH=20

# Database Configuration (Supabase PostgreSQL / Cloud Postgres / Local SQLite)
# Transaction/Session pooler (Recommended for Supabase, IPv4-compatible, port 6543 or 5432):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Or using SUPABASE_DATABASE_URL alias:
# SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_role_key
# Optional custom database & log locations for SQLite fallback
# MAILPILOT_DB_PATH=data/mailpilot.db
# MAILPILOT_LOG_PATH=data/mailpilot.log

# Proactive Important-Email Monitoring & Follow-up Tracking
FOLLOWUP_DAYS=3
ALERTS_PER_HOUR_MAX=5

# Conversational Memory Settings
MEMORY_ENABLED=true
MEMORY_MAX_TOKENS=500
MEMORY_INCLUDES_EMAILS=false

# [DEPRECATED] Ngrok authentication token (legacy local tunneling)
NGROK_AUTHTOKEN=your_ngrok_token_here
